{
  "name": "pi-advisor",
  "version": "0.1.0",
  "description": "Pi extension that adds an advisor tool and commands backed by a stronger model.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgint/pi-advisor.git"
  },
  "author": "cgint",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "advisor",
    "planning"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "tsc --noEmit && npm run test && npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "7.16.0"
  }
}
